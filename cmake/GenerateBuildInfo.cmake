if (NOT DEFINED QE_OUTPUT_FILE OR QE_OUTPUT_FILE STREQUAL "")
  message(FATAL_ERROR "QE_OUTPUT_FILE is required")
endif()

if (NOT DEFINED QE_SOURCE_DIR OR QE_SOURCE_DIR STREQUAL "")
  message(FATAL_ERROR "QE_SOURCE_DIR is required")
endif()

if (NOT DEFINED QE_ENGINE_VERSION OR QE_ENGINE_VERSION STREQUAL "")
  set(QE_ENGINE_VERSION "unknown")
endif()

set(QE_GIT_COMMIT "unknown")
set(QE_GIT_DIRTY 0)

find_program(QE_GIT_EXECUTABLE git)
if (QE_GIT_EXECUTABLE)
  execute_process(
    COMMAND "${QE_GIT_EXECUTABLE}" -C "${QE_SOURCE_DIR}" rev-parse --short=12 HEAD
    RESULT_VARIABLE QE_GIT_COMMIT_RESULT
    OUTPUT_VARIABLE QE_GIT_COMMIT_OUTPUT
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
  )
  if (QE_GIT_COMMIT_RESULT EQUAL 0 AND NOT QE_GIT_COMMIT_OUTPUT STREQUAL "")
    set(QE_GIT_COMMIT "${QE_GIT_COMMIT_OUTPUT}")
  endif()

  execute_process(
    COMMAND "${QE_GIT_EXECUTABLE}" -C "${QE_SOURCE_DIR}" status --porcelain --untracked-files=normal
    RESULT_VARIABLE QE_GIT_STATUS_RESULT
    OUTPUT_VARIABLE QE_GIT_STATUS_OUTPUT
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
  )
  if (QE_GIT_STATUS_RESULT EQUAL 0 AND NOT QE_GIT_STATUS_OUTPUT STREQUAL "")
    set(QE_GIT_DIRTY 1)
  endif()
endif()

set(QE_BUILD_INFO_CONTENT "#pragma once\n\n#define QE_ENGINE_VERSION \"${QE_ENGINE_VERSION}\"\n#define QE_BUILD_GIT_COMMIT \"${QE_GIT_COMMIT}\"\n#define QE_BUILD_GIT_DIRTY ${QE_GIT_DIRTY}\n")

get_filename_component(QE_OUTPUT_DIRECTORY "${QE_OUTPUT_FILE}" DIRECTORY)
file(MAKE_DIRECTORY "${QE_OUTPUT_DIRECTORY}")

set(QE_EXISTING_BUILD_INFO "")
if (EXISTS "${QE_OUTPUT_FILE}")
  file(READ "${QE_OUTPUT_FILE}" QE_EXISTING_BUILD_INFO)
endif()

if (NOT QE_EXISTING_BUILD_INFO STREQUAL QE_BUILD_INFO_CONTENT)
  file(WRITE "${QE_OUTPUT_FILE}" "${QE_BUILD_INFO_CONTENT}")
endif()
